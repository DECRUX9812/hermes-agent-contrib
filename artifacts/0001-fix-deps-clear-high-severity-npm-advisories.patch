From c687836fecc63f253f601b0ae117472a81a3ee95 Mon Sep 17 00:00:00 2001
From: Ritesh Patel <DECRUX9812@users.noreply.github.com>
Date: Sun, 23 Aug 2026 04:32:59 -0600
Subject: [PATCH] fix(deps): clear high-severity npm advisories

Upgrade Electron to 41.10.6, replace the vulnerable extract-zip chain, and refresh nanoid/postcss overrides so a clean npm ci reports zero vulnerabilities.
---
 .npmrc                    |   7 +-
 apps/desktop/package.json |   4 +-
 package-lock.json         | 385 ++++++++++++++------------------------
 package.json              |   6 +-
 4 files changed, 149 insertions(+), 253 deletions(-)

diff --git a/.npmrc b/.npmrc
index 0e25208461..876d235c6a 100644
--- a/.npmrc
+++ b/.npmrc
@@ -37,9 +37,6 @@ min-release-age-exclude[]=brace-expansion
 # js-yaml 4.3.1 includes fixes for GHSA-5p4m-2wfm-xmqj. remove when > 2wks old (rel 2026-07-31)
 min-release-age-exclude[]=js-yaml
 
-# nanoid 3.3.17 includes fixes for GHSA-2v37-7h3g-55p8. remove when > 2wks old (rel 2026-08-03)
-min-release-age-exclude[]=nanoid
-
 # mermaid 11.16.1 includes fixes for 5 GHSAs. remove when > 2wks old (rel 2026-08-04)
 min-release-age-exclude[]=mermaid
 
@@ -61,3 +58,7 @@ min-release-age-exclude[]=@oxc-project/types
 # ink needs
 min-release-age-exclude[]=lightningcss
 min-release-age-exclude[]=postcss
+
+# electron 41.10.6 includes fixes for GHSA-9f4c-93c8-jc8g and replaces the
+# vulnerable extract-zip dependency. remove once 41.10.6 is > 2wks old.
+min-release-age-exclude[]=electron
